# 로컬 개발용 예시 — 실제 값은 .env 파일에 (커밋되지 않음)

# 로컬 개발: better-sqlite3로 로컬 파일에 붙는다 (TURSO_DATABASE_URL이 없을 때).
DATABASE_URL="file:./dev.db"

# 프로덕션(Vercel)에서만 설정 — 있으면 libsql로 Turso 원격 DB에 붙는다 (src/lib/db.ts 참고).
# TURSO_DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<turso db tokens create 로 발급>"

# 운영자 전용 쓰기 권한 게이트
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# "세종철인 인증" — 대회기록/개인기록 열람 게이트 (운영자 암호와 별개 시스템)
SEJONG_AUTH_PASSWORD="change-me"
SEJONG_AUTH_SESSION_SECRET="change-me-to-a-long-random-string"
